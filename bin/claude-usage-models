#!/usr/bin/env python3
"""Estimates how this week's Claude Code usage splits by model.

The usage API has no per-model number for most models, so this reads Claude
Code's own transcripts and weights tokens by API list price, which is the best
available stand-in for how fast each model drains a plan. It gives a share, and
that share is an estimate: Anthropic doesn't publish how plan limits weigh
tokens, and claude.ai chats and cloud sessions leave no transcript here.

Other Macs on the same account can be included by listing them in
~/.config/claude-usage/hosts, one "Label ssh-target" per line. This script
pipes itself to each over ssh, so they only need python3 and their transcripts.

  claude-usage-models [--since ISO-8601] [--json]
"""
import argparse
import datetime
import glob
import json
import os
import subprocess
import sys

HOSTS_FILE = os.path.expanduser("~/.config/claude-usage/hosts")
PROJECTS = os.path.expanduser("~/.claude/projects/**/*.jsonl")

# USD per million tokens: input, output, cache read. Cache writes are derived
# from input (1.25x for the 5-minute cache, 2x for the 1-hour cache).
# Longest prefix wins, so "claude-opus-5-5" is matched before "claude-opus-5".
PRICES = {
    "claude-fable-5-1": (10.00, 50.00, 0.25),
    "claude-mythos-5-1": (10.00, 50.00, 0.25),
    "claude-fable-5": (10.00, 50.00, 1.00),
    "claude-mythos-5": (10.00, 50.00, 1.00),
    "claude-opus-5-5": (4.00, 20.00, 0.20),
    "claude-opus-5": (5.00, 25.00, 0.50),
    "claude-opus-4": (5.00, 25.00, 0.50),
    "claude-sonnet-5-5": (2.00, 10.00, 0.20),
    "claude-sonnet-5": (2.00, 10.00, 0.20),
    "claude-sonnet-4": (3.00, 15.00, 0.30),
    "claude-haiku-5-5": (0.10, 0.50, 0.01),
    "claude-haiku-4": (1.00, 5.00, 0.10),
}
# Haiku 5.5 costs five times as much once a prompt passes 100K tokens.
HAIKU_55_LONG_PROMPT = 100_000
HAIKU_55_LONG_PROMPT_FACTOR = 5


def prices_for(model):
    for prefix in sorted(PRICES, key=len, reverse=True):
        if model.startswith(prefix):
            return PRICES[prefix]
    return None


def cost_of(model, usage):
    p = prices_for(model)
    if p is None:
        return None
    tin = usage.get("input_tokens") or 0
    tout = usage.get("output_tokens") or 0
    read = usage.get("cache_read_input_tokens") or 0
    write = usage.get("cache_creation_input_tokens") or 0
    per_ttl = usage.get("cache_creation") or {}
    write_1h = per_ttl.get("ephemeral_1h_input_tokens") or 0
    write_5m = max(0, write - write_1h)
    factor = 1
    if model.startswith("claude-haiku-5-5") and tin + read + write > HAIKU_55_LONG_PROMPT:
        factor = HAIKU_55_LONG_PROMPT_FACTOR
    pin, pout, pread = (x * factor for x in p)
    return (tin * pin + tout * pout + read * pread
            + write_5m * pin * 1.25 + write_1h * pin * 2) / 1e6


def parse_since(text):
    t = datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))
    if t.tzinfo is None:
        t = t.replace(tzinfo=datetime.timezone.utc)
    return t.astimezone(datetime.timezone.utc)


def scan(since):
    """Totals per model for this machine. Claude Code writes one line per content
    block, all carrying the same message id and usage, and a resumed session can
    repeat earlier messages in a new file, so each id must count once."""
    stamp = since.strftime("%Y-%m-%dT%H:%M:%S")
    epoch = since.timestamp()
    seen = {}
    for path in glob.iglob(PROJECTS, recursive=True):
        try:
            if os.path.getmtime(path) < epoch:
                continue
            with open(path, "rb") as f:
                for line in f:
                    if b'"assistant"' not in line:
                        continue
                    try:
                        e = json.loads(line)
                    except ValueError:
                        continue
                    if e.get("type") != "assistant" or (e.get("timestamp") or "") < stamp:
                        continue
                    m = e.get("message") or {}
                    mid, model, usage = m.get("id"), m.get("model"), m.get("usage")
                    if not (mid and model and usage) or model == "<synthetic>":
                        continue
                    # Output counts grow while a message streams: keep the largest.
                    old = seen.get(mid)
                    if old is None or (usage.get("output_tokens") or 0) >= (old[1].get("output_tokens") or 0):
                        seen[mid] = (model, usage)
        except OSError:
            continue

    models, unpriced = {}, {}
    for model, usage in seen.values():
        cost = cost_of(model, usage)
        if cost is None:
            unpriced[model] = unpriced.get(model, 0) + 1
            continue
        a = models.setdefault(model, {"cost": 0.0, "messages": 0})
        a["cost"] += cost
        a["messages"] += 1
    return {"models": models, "unpriced": unpriced}


def read_hosts():
    hosts = []
    try:
        with open(HOSTS_FILE) as f:
            for line in f:
                parts = line.split("#")[0].split()
                if len(parts) == 2:
                    hosts.append(tuple(parts))
    except OSError:
        pass
    return hosts


def scan_remote(target, since):
    with open(os.path.abspath(__file__), "rb") as me:
        out = subprocess.run(
            ["/usr/bin/ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=4", target,
             "python3", "-", "--scan", "--since", since.isoformat()],
            stdin=me, capture_output=True, timeout=25, check=True).stdout
    return json.loads(out)


def pretty(model):
    # "claude-opus-5-5" -> "Opus 5.5"; dated ids lose the date.
    parts = [p for p in model.split("-")[1:] if not (p.isdigit() and len(p) >= 6)]
    if not parts:
        return model
    return parts[0].capitalize() + (" " + ".".join(parts[1:]) if parts[1:] else "")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--since")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--scan", action="store_true", help=argparse.SUPPRESS)
    args = ap.parse_args()

    now = datetime.datetime.now(datetime.timezone.utc)
    since = parse_since(args.since) if args.since else now - datetime.timedelta(days=7)

    if args.scan:
        print(json.dumps(scan(since)))
        return

    results, unreachable = [("This Mac", scan(since))], []
    for label, target in read_hosts():
        try:
            results.append((label, scan_remote(target, since)))
        except (OSError, ValueError, subprocess.SubprocessError):
            unreachable.append(label)

    totals, unpriced = {}, {}
    for _, r in results:
        for model, a in r["models"].items():
            t = totals.setdefault(pretty(model), {"cost": 0.0, "messages": 0})
            t["cost"] += a["cost"]
            t["messages"] += a["messages"]
        for model, n in r["unpriced"].items():
            unpriced[model] = unpriced.get(model, 0) + n

    whole = sum(t["cost"] for t in totals.values())
    rows = [{"name": name,
             "share": round(100 * t["cost"] / whole, 1) if whole else 0,
             "api_usd": round(t["cost"], 2),
             "messages": t["messages"]}
            for name, t in sorted(totals.items(), key=lambda kv: -kv[1]["cost"])]
    report = {"since": since.isoformat(), "models": rows,
              "hosts": [label for label, _ in results],
              "unreachable": unreachable, "unpriced": unpriced}

    if args.json:
        print(json.dumps(report))
        return

    local = since.astimezone().strftime("%a %b %d %H:%M")
    print("\n  Estimated split by model since %s (%s)" % (local, " + ".join(report["hosts"])))
    for r in rows:
        print("    %-12s %5.1f%%   $%-9.2f %6d messages" % (r["name"], r["share"], r["api_usd"], r["messages"]))
    print("    Dollars are API list prices, used only as weights. Your plan isn't billed this way.")
    if unreachable:
        print("    Not counted, unreachable: " + ", ".join(unreachable))
    if unpriced:
        print("    Not counted, no price known: " + ", ".join(sorted(unpriced)))
    print()


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
